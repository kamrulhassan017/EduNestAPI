# Copy this file to .env and fill in your own values.
# Never commit .env.

# App
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=edunest_user
DB_PASSWORD=change_me
DB_NAME=edunest_db
DB_LOGGING=false

# Auth (Member 2)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# First admin, created automatically on start-up if no admin exists
ADMIN_NAME=EduNest Admin
ADMIN_EMAIL=admin@edunest.local
ADMIN_PASSWORD=Admin@12345

# Mail (used by the Mailer; Mailtrap sandbox while testing)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="EduNest <no-reply@edunest.local>"
